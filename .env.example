# ============================================================================
# .env.example — placeholders for every real value in .env (gitignored)
# ----------------------------------------------------------------------------
# Copy this to `.env` and fill in your lab's values. Every secret / IP in the
# committed YAMLs + scripts + launchers reads from here.
# ============================================================================

# ── Host IPs (LAN) ───────────────────────────────────────────────────────────
HOST_DATABRICK=__FILL_ME__        # e.g. 192.168.86.48
HOST_DGXSPARK=__FILL_ME__         # e.g. 192.168.86.39
HOST_5090=__FILL_ME__            # e.g. 192.168.86.37
HOST_3090=__FILL_ME__            # e.g. 192.168.86.48
HOST_5090_PORT=8201              # vLLM (5090) port contract 8200-8299
HOST_3090_PORT=8101              # llama.cpp (3090) port contract 8100-8199
HOST_SPARK_PORT=8401             # vision (Spark) port contract 8400-8499

# ── Router API key ───────────────────────────────────────────────────────────
# Claude Code's ANTHROPIC_AUTH_TOKEN. The Go router does not enforce it today;
# the legacy :8010 Python router does.
ROUTER_API_KEY=__FILL_ME__

# ── Portainer (server on Databrick, endpoint 3 = local Docker socket) ───────
PORTAINER_USERNAME=__FILL_ME__
PORTAINER_PASSWORD=__FILL_ME__
PORTAINER_API_URL=http://__FILL_ME__:9000/api
PORTAINER_ENDPOINT_DATABRICK=3

# ── UI credentials (basic-auth dashboards) ───────────────────────────────────
# qwen38-router-status (:8091) and qwen38-router-ui (:8090, retired).
UI_STATUS_USER=__FILL_ME__
UI_STATUS_PASS=__FILL_ME__
UI_UI_USER=__FILL_ME__
UI_UI_PASS=__FILL_ME__

# ── Grafana (on DGX Spark) ───────────────────────────────────────────────────
GRAFANA_URL=http://__FILL_ME__/grafana
GRAFANA_USER=__FILL_ME__
GRAFANA_PASSWORD=__FILL_ME__

# ── SSH (all key-based, no passwords) ────────────────────────────────────────
# Aliases are in ~/.ssh/config: databricks (id_rsa), dgxspark (id_ed25519,
# ProxyJump databricks). No passwords, so these are not secrets.
SSH_USER=__FILL_ME__
SSH_HOST=__FILL_ME__
SSH_KEY_PATH=~/.ssh/id_rsa
