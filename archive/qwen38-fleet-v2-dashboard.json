        "targets": [
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "A",
            "legendFormat": "p50 ({{device}})", "expr": "histogram_quantile(0.5, sum by (device, le) (rate(vllm:e2e_request_latency_seconds_bucket{device=~\"$device\"}[$__rate_interval])))" },
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "B",
            "legendFormat": "p95 ({{device}})", "expr": "histogram_quantile(0.95, sum by (device, le) (rate(vllm:e2e_request_latency_seconds_bucket{device=~\"$device\"}[$__rate_interval])))" },
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "C",
            "legendFormat": "p99 ({{device}})", "expr": "histogram_quantile(0.99, sum by (device, le) (rate(vllm:e2e_request_latency_seconds_bucket{device=~\"$device\"}[$__rate_interval])))" }
        ]
      },
      {
        "id": 3001, "type": "bargauge", "title": "MODEL THROUGHPUT COMPARISON",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "#76B900" },
            "max": 100, "min": 0, "unit": "tps", "noValue": "—"
          }, "overrides": []
        },
        "options": { "displayMode": "gradient", "orientation": "auto" },
        "targets": [
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "A",
            "legendFormat": "{{model_name}}", "expr": "sum by (model_name) (rate(vllm:generation_tokens_total[$__rate_interval]))" }
        ]
      },
      {
        "id": 3002, "type": "bargauge", "title": "MODEL TTFT P95 COMPARISON",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "#FFC556" },
            "unit": "s", "noValue": "—"
          }, "overrides": []
        },
        "options": { "displayMode": "gradient", "orientation": "auto" },
        "targets": [
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "A",
            "legendFormat": "{{model_name}}", "expr": "max by (model_name) (histogram_quantile(0.95, sum by (model_name, le) (rate(vllm:time_to_first_token_seconds_bucket[$__rate_interval]))))" }
        ]
      },
      {
        "id": 3003, "type": "bargauge", "title": "MODEL QUEUE PRESSURE",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
        "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "#F2E9B0" },
            "unit": "short", "noValue": "—"
          }, "overrides": []
        },
        "options": { "displayMode": "gradient", "orientation": "auto" },
        "targets": [
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "A",
            "legendFormat": "{{model_name}}", "expr": "sum by (model_name) (vllm:num_requests_waiting)" }
        ]
      },
      {
        "id": 4001, "type": "timeseries", "title": "SPARK CPU / MEMORY / DISK",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
        "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "fixed", "fixedColor": "#A4D65E" },
            "custom": { "drawStyle": "line", "fillOpacity": 5, "lineInterpolation": "smooth", "lineWidth": 1, "showPoints": "never" },
            "thresholds": { "mode": "absolute", "steps": [ { "color": "#A4D65E", "value": 0 } ] },
            "unit": "short", "noValue": "—"
          }, "overrides": []
        },
        "options": {
          "legend": { "calcs": ["lastNotNull","mean"], "displayMode": "table", "placement": "bottom", "showLegend": true },
          "tooltip": { "hideZeros": false, "mode": "multi" }
        },
        "targets": [
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "A",
            "legendFormat": "cpu %", "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))" },
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "B",
            "legendFormat": "mem used GiB", "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1073741824" },
          { "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" }, "refId": "C",
            "legendFormat": "root disk %", "expr": "100 * (1 - avg(node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}))" }
        ]
      },
      {
        "id": 4002, "type": "timeseries", "title": "ROUTER LOAD (DATABRICK 8010)",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
        "datasource": { "type": "prometheus", "uid": "dfr1d9ottv8xsc" },
