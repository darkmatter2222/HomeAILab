# ============================================================================
# harness/.env.example - placeholders for the variables the harness launchers
# read.
# ----------------------------------------------------------------------------
# Copy this to `harness\.env` (gitignored) if you do NOT have the repo-root
# .env. If the repo-root .env exists, load-env.bat uses it directly and this
# file is not needed - the root .env already defines every variable below.
# ============================================================================

# Host LAN IPs (same names as the repo-root .env)
HOST_3090=__FILL_ME__     # Databrick RTX 3090 (llama.cpp)
HOST_5090=__FILL_ME__     # RedPCv2 RTX 5090 (vLLM)
HOST_DGXSPARK=__FILL_ME__ # DGX Spark (vision / vLLM)

# Router API key (Go router on :8001; used as ANTHROPIC_AUTH_TOKEN by the
# claude-cluster launcher). The router does not enforce it today.
ROUTER_API_KEY=__FILL_ME__
